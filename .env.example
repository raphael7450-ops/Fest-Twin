# Server runtime only. Do not expose this key through a VITE_ variable.
TOUR_API_KEY=replace-with-your-tourapi-service-key

# Browser public client key for NAVER Maps JavaScript API v3.
# This is not a server secret, but do not commit a real project key.
VITE_NAVER_MAP_NCP_KEY_ID=replace-with-your-naver-maps-ncp-key-id
