# Server runtime only. Do not expose this key through a VITE_ variable.
TOUR_API_KEY=replace-with-your-tourapi-service-key

# Optional server-side key for data.go.kr national culture festival standard data.
STANDARD_FESTIVAL_API_KEY=replace-with-your-standard-festival-service-key
PUBLIC_CULTURE_FESTIVAL_API_KEY=replace-with-your-standard-festival-service-key

# Browser public client key for VWorld 2D map JavaScript API.
# This is not a server secret, but do not commit a real project key.
VITE_VWORLD_API_KEY=replace-with-your-vworld-api-key

# Express server port and environment
PORT=80
NODE_ENV=production

# Naver DataLab API proxy credentials
NAVER_DATALAB_CLIENT_ID=replace-with-naver-client-id
NAVER_DATALAB_CLIENT_SECRET=replace-with-naver-client-secret

# IP rate limiting configuration
GENERAL_RATE_LIMIT_MAX=300
OPEN_API_RATE_LIMIT_MAX=120

# Logging and backup directory paths
LOG_DIR=./logs
BACKUP_DIR=./backups

# Deployment target URL for health checking
DEPLOY_TARGET_URL=https://cwserver.tail97dbc3.ts.net

# Tourism demand consumption operation name
TOURISM_DEMAND_CONSUMPTION_OPERATION=

# Offline / Air-gap mode flag (true: force offline fallback data)
OFFLINE_MODE=false

# Weather API key (when server-side weather proxy is active)
WEATHER_API_KEY=replace-with-kma-weather-key

CITY_PARK_API_KEY=replace-with-your-city-park-service-key

